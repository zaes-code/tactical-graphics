{
  "name": "@zaes/tactical-graphics",
  "version": "4.1.0",
  "description": "MIL-STD-2525E / FM 1-02.2 / APP-06 tactical graphics as plain GeoJSON. Renders axis-of-advance arrows, phase lines, mission tasks, and range fans for OpenLayers or any GeoJSON consumer.",
  "keywords": [
    "mil-std-2525",
    "mil-std-2525e",
    "2525",
    "app-06",
    "fm-1-02.2",
    "tactical-graphics",
    "military-symbols",
    "military-symbology",
    "symbology",
    "military",
    "defense",
    "operational-graphics",
    "control-measures",
    "mission-tasks",
    "command-and-control",
    "c2",
    "common-operational-picture",
    "situational-awareness",
    "milsymbol",
    "geojson",
    "openlayers",
    "maplibre",
    "gis",
    "geospatial",
    "cartography",
    "turf",
    "mapping",
    "typescript",
    "edit"
  ],
  "author": "ZAES",
  "contributors": [
    "Edwin Sanchez <edwin.sanchez@zaes.com>",
    "Eric Marks <eric.marks@zaes.com>",
    "Navie Huynh"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaes-code/tactical-graphics.git"
  },
  "bugs": {
    "url": "https://github.com/zaes-code/tactical-graphics/issues"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./openlayers": {
      "types": "./dist/ol/types/components/openlayers/index.d.ts",
      "import": "./dist/ol/esm/components/openlayers/index.js",
      "require": "./dist/ol/cjs/components/openlayers/index.js"
    },
    "./maplibre": {
      "types": "./dist/mlb/types/components/maplibre/index.d.ts",
      "import": "./dist/mlb/esm/components/maplibre/index.js",
      "require": "./dist/mlb/cjs/components/maplibre/index.js"
    },
    "./thumbnails": {
      "types": "./dist/types/assets/graphicThumbnails.d.ts",
      "import": "./dist/esm/assets/graphicThumbnails.js",
      "require": "./dist/cjs/assets/graphicThumbnails.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prestart": "node scripts/copy-maplibre-worker.js",
    "start": "vite",
    "build": "node scripts/build-lib.js",
    "prebuild:demo": "node scripts/copy-maplibre-worker.js",
    "build:demo": "vite build",
    "test": "vitest run",
    "drive": "node scripts/drive-app.mjs",
    "drive:edit": "node scripts/drive-edit-mode.mjs",
    "compare:engines": "node scripts/compare-engines.mjs",
    "shoot-gallery": "node scripts/shoot-gallery.mjs",
    "gen:catalog": "node scripts/gen-catalog-svgs.js --profile catalog",
    "gen:thumbnails": "node scripts/gen-catalog-svgs.js --profile thumbnail",
    "postgen:thumbnails": "node scripts/build-lib.js",
    "check:thumbnails": "node scripts/gen-catalog-svgs.js --profile thumbnail --check",
    "typecheck": "tsc --noEmit",
    "check:readme-samples": "node scripts/check-readme-samples.mjs",
    "gen:field-matrix": "node scripts/gen-field-matrix.mjs",
    "check:field-matrix": "node scripts/gen-field-matrix.mjs --check",
    "check:conformance": "node ai/conformance/build-report.mjs --check",
    "check:tracker": "python scripts/gen-readme-graphics-table.py --check",
    "gen:app6-review": "python scripts/gen-app6-review-sheet.py",
    "check:app6-review": "python scripts/gen-app6-review-sheet.py --check",
    "check:tracker-hierarchy": "python scripts/gen-tracker-hierarchy.py --check",
    "check:docs": "npm run check:thumbnails && npm run check:field-matrix && npm run check:readme-samples && npm run check:layering",
    "check:docs:internal": "npm run check:docs && npm run check:conformance && npm run check:tracker && npm run check:app6-review && npm run check:tracker-hierarchy",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test:watch": "vitest",
    "preview": "vite preview",
    "check:layering": "node scripts/check-layering.mjs"
  },
  "dependencies": {
    "@turf/along": "^7.4.0",
    "@turf/bearing": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/clone": "^7.4.0",
    "@turf/destination": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/invariant": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/line-arc": "^7.4.0",
    "@turf/line-offset": "^7.4.0",
    "@turf/line-slice-along": "^7.4.0",
    "@turf/meta": "^7.4.0",
    "@turf/midpoint": "^7.4.0",
    "@turf/point-on-feature": "^7.4.0",
    "@turf/point-to-line-distance": "^7.4.0",
    "@turf/transform-rotate": "^7.4.0",
    "@turf/transform-scale": "^7.4.0",
    "@turf/transform-translate": "^7.4.0",
    "@types/geojson": "^7946.0.16"
  },
  "peerDependencies": {
    "maplibre-gl": ">=4",
    "milsymbol": ">=3",
    "ol": ">=9"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "milsymbol": {
      "optional": true
    },
    "ol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "jsdom": "^29.1.1",
    "maplibre-gl": "^6.2.0",
    "milsymbol": "^3.0.2",
    "ol": "^10.5.0",
    "ol-ext": "^4.0.27",
    "playwright": "^1.61.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-draggable": "^4.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "web-vitals": "^2.1.4"
  }
}
